# Which AI provider to use: ollama (local, default) | huggingface | mock
ADVISOR_PROVIDER=ollama

# --- Ollama (local open models) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl        # alternatives: llava, llama3.2-vision

# --- Hugging Face Inference API (hosted open models) ---
# Free token: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
