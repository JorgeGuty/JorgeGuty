  "edges": [
    { "source": "ziggy-stardust", "target": "whizz-kid", "tipo_de_influencia": "sonido", "explicación": "Whizz Kid es glam rock moldeado directamente por la teatralidad y el sonido de Ziggy Stardust." },
    { "source": "ziggy-stardust", "target": "ok-computer", "tipo_de_influencia": "linaje", "explicación": "Radiohead hereda de Bowie la ambición conceptual y camaleónica del art rock británico." },
    { "source": "wish-you-were-here", "target": "ok-computer", "tipo_de_influencia": "sonido", "explicación": "Las atmósferas progresivas y la alienación tecnológica de Pink Floyd son el precedente directo de OK Computer." },
    { "source": "ok-computer", "target": "in-rainbows", "tipo_de_influencia": "evolución interna", "explicación": "Radiohead evoluciona de la paranoia digital de OK Computer al calor orgánico de In Rainbows." },
    { "source": "in-rainbows", "target": "i-didnt-mean-to-haunt-you", "tipo_de_influencia": "sonido", "explicación": "Quadeca cita a Radiohead como referencia central del art pop fracturado de este disco." },
    { "source": "i-didnt-mean-to-haunt-you", "target": "scrapyard", "tipo_de_influencia": "evolución interna", "explicación": "SCRAPYARD recicla la paleta experimental de IDMTHY en formato colección de descartes elevados." },
    { "source": "scrapyard", "target": "vanisher-horizon-scraper", "tipo_de_influencia": "evolución interna", "explicación": "Quadeca expande su art pop hacia paisajes ambientales de largo aliento." },
    { "source": "ok-computer", "target": "ants-from-up-there", "tipo_de_influencia": "escena", "explicación": "El post-rock emocional de Black Country, New Road se lee como heredero del art rock de Radiohead." },
    { "source": "ants-from-up-there", "target": "live-at-bush-hall", "tipo_de_influencia": "evolución interna", "explicación": "Tras la salida de Isaac Wood, la banda reinventa su repertorio en vivo en Bush Hall." },
    { "source": "live-at-bush-hall", "target": "forever-howlong", "tipo_de_influencia": "evolución interna", "explicación": "El formato coral de Bush Hall cristaliza en el folk barroco de Forever Howlong." },
    { "source": "fleet-foxes", "target": "forever-howlong", "tipo_de_influencia": "sonido", "explicación": "El giro folk barroco y coral de BCNR dialoga con la tradición armónica de Fleet Foxes." },
    { "source": "faith", "target": "head-on-the-door", "tipo_de_influencia": "evolución interna", "explicación": "The Cure sale del túnel gótico de Faith hacia el pop luminoso de The Head On The Door." },
    { "source": "head-on-the-door", "target": "disintegration", "tipo_de_influencia": "evolución interna", "explicación": "La madurez pop de 1985 desemboca en la catedral melancólica de Disintegration." },
    { "source": "faith", "target": "heaven-or-las-vegas", "tipo_de_influencia": "escena", "explicación": "El post-punk atmosférico británico de principios de los 80 abrió el espacio sonoro donde florecieron los Cocteau Twins." },
    { "source": "hatful-of-hollow", "target": "queen-is-dead", "tipo_de_influencia": "evolución interna", "explicación": "Las sesiones tempranas de Hatful Of Hollow maduran en la obra cumbre The Queen Is Dead." },
    { "source": "queen-is-dead", "target": "irreversible", "tipo_de_influencia": "sonido", "explicación": "Brigitte Calls Me Baby revive explícitamente el romanticismo vocal y las guitarras jangle de The Smiths." },
    { "source": "heaven-or-las-vegas", "target": "depression-cherry", "tipo_de_influencia": "sonido", "explicación": "Beach House desciende directamente del dream pop etéreo y las texturas de los Cocteau Twins." },
    { "source": "heaven-or-las-vegas", "target": "so-tonight-that-i-might-see", "tipo_de_influencia": "escena", "explicación": "Mazzy Star comparte la bruma sensual del dream pop noventero que definieron los Cocteau Twins." },
    { "source": "so-tonight-that-i-might-see", "target": "romanticism", "tipo_de_influencia": "sonido", "explicación": "La intimidad narcótica de Hope Sandoval resuena en el indie confesional de Hana Vu." },
    { "source": "is-this-it", "target": "room-on-fire", "tipo_de_influencia": "evolución interna", "explicación": "Room On Fire refina la fórmula garage-pop que Is This It volvió canon." },
    { "source": "room-on-fire", "target": "new-abnormal", "tipo_de_influencia": "evolución interna", "explicación": "The New Abnormal reencuentra a los Strokes con sintetizadores y madurez melódica." },
    { "source": "random-access-memories", "target": "currents", "tipo_de_influencia": "producción", "explicación": "Kevin Parker giró hacia el disco y los sintetizadores tras la ola retro-futurista de Daft Punk." },
    { "source": "random-access-memories", "target": "dawn-fm", "tipo_de_influencia": "producción", "explicación": "Dawn FM extiende el revival disco-synth que Daft Punk reinstaló en el pop (y ya habían colaborado en Starboy)." },
    { "source": "prince", "target": "dawn-fm", "tipo_de_influencia": "sonido", "explicación": "El funk-pop sintético de Prince es la gramática base del pop nocturno de The Weeknd." },
    { "source": "purple-rain", "target": "blond", "tipo_de_influencia": "linaje", "explicación": "Frank Ocean cita a Prince como influencia formativa en su mezcla de R&B, rock y vulnerabilidad." },
    { "source": "blond", "target": "fuck-the-world", "tipo_de_influencia": "sonido", "explicación": "El R&B difuso y confesional de Brent Faiyaz parte del molde de Blond." },
    { "source": "blond", "target": "igor", "tipo_de_influencia": "colaboración", "explicación": "Tyler y Frank Ocean (Odd Future) se influyen mutuamente; Igor extiende la paleta emocional de Blond." },
    { "source": "igor", "target": "pixel-bath", "tipo_de_influencia": "escena", "explicación": "El pop género-fluido de Jean Dawson florece en el espacio que Igor abrió para el pop alternativo negro." },
    { "source": "pixel-bath", "target": "glimmer-of-god", "tipo_de_influencia": "evolución interna", "explicación": "Jean Dawson refina el collage de Pixel Bath hacia un pop más espiritual y expansivo." },
    { "source": "prince", "target": "two-star-dream-police", "tipo_de_influencia": "sonido", "explicación": "La guitarra procesada y el falsete de Mk.gee remiten directamente al minimalismo funk de Prince." },
    { "source": "purple-rain", "target": "all-american-fckboy", "tipo_de_influencia": "sonido", "explicación": "Duckwrth funde funk, punk y pop con la teatralidad heredada de Prince." },
    { "source": "devil-and-god", "target": "legends-never-die", "tipo_de_influencia": "linaje", "explicación": "El emo rap de Juice WRLD desciende del emo de los 2000 que Brand New llevó a su cima." },
    { "source": "kids-see-ghosts", "target": "legends-never-die", "tipo_de_influencia": "sonido", "explicación": "Juice WRLD citaba a Kid Cudi como su mayor influencia; el hum melódico de Kids See Ghosts está en su ADN." },
    { "source": "kids-see-ghosts", "target": "dont-be-dumb", "tipo_de_influencia": "escena", "explicación": "El maximalismo experimental de Kanye y Cudi marcó el camino del hip hop artístico que A$AP Rocky recorre." },
    { "source": "still-dre", "target": "under-pressure", "tipo_de_influencia": "producción", "explicación": "Logic construye sobre el boom bap clásico y la producción nítida de la era Dre." },
    { "source": "louie-and-the-dukes", "target": "cowboy-bebop", "tipo_de_influencia": "homenaje", "explicación": "La banda sonora de Cowboy Bebop es un homenaje directo al jazz y dixieland de la era Armstrong." },
    { "source": "currents", "target": "mercurial-world", "tipo_de_influencia": "escena", "explicación": "El pop psicodélico-sintético de Magdalena Bay hereda el mundo sonoro que Currents popularizó." },
    { "source": "how-im-feeling-now", "target": "mercurial-world", "tipo_de_influencia": "escena", "explicación": "Mercurial World comparte el ADN hyperpop/DIY que Charli XCX cristalizó en cuarentena." }
